#version 450

#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_integer_dot_product : require

#define MMQ
#define NEEDS_IQ1S_GRID_GPU
#define KVALUES_IQ4NL_I8
#define B_TYPE block_q8_1_x4

#include "mul_mat_vec_base.glsl"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

#if defined(DATA_A_Q2_0) || defined(DATA_A_QUANT_K)
#define K_PER_ITER 16
#elif defined(DATA_A_QUANT_LEGACY) || defined(DATA_A_MXFP4)
#define K_PER_ITER 8
#elif defined(DATA_A_IQ1_S) || defined(DATA_A_IQ1_M) || defined(DATA_A_IQ4_XS)
#define K_PER_ITER 32
#else
#error unimplemented
#endif

uint a_offset, b_offset, d_offset;

int32_t cache_b_qs[K_PER_ITER / 4];
vec2 cache_b_ds;

uint pair_weight;
#include "mul_mat_vecq_funcs.glsl"

void iter(inout FLOAT_TYPE temp[NUM_COLS][NUM_ROWS], const uint first_row, const uint num_rows, const uint col, const uint b_qs_idx) {
    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        // Preload data_b block
        const uint b_block_idx = (j*p.batch_stride_b + col) / QUANT_K_Q8_1 + b_offset;
        const uint b_block_idx_outer = b_block_idx / 4;
        const uint b_block_idx_inner = b_block_idx % 4;
        cache_b_ds = vec2(data_b[b_block_idx_outer].ds[b_block_idx_inner]);

#if QUANT_R == 2
        // Assumes K_PER_ITER == 8
        cache_b_qs[0] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx];
        cache_b_qs[1] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx + 4];
#else
#if K_PER_ITER == 8
        cache_b_qs[0] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 2];
        cache_b_qs[1] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 2 + 1];
#elif K_PER_ITER == 16
        cache_b_qs[0] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 4    ];
        cache_b_qs[1] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 4 + 1];
        cache_b_qs[2] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 4 + 2];
        cache_b_qs[3] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 4 + 3];
#elif K_PER_ITER == 32
        cache_b_qs[0] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8    ];
        cache_b_qs[1] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + 1];
        cache_b_qs[2] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + 2];
        cache_b_qs[3] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + 3];
        cache_b_qs[4] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + 4];
        cache_b_qs[5] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + 5];
        cache_b_qs[6] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + 6];
        cache_b_qs[7] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + 7];
#else
#error unimplemented
#endif
#endif

        uint ibi = (first_row/2)*p.ncols;
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            const uint a_block_idx = (ibi + col)/QUANT_K_Q8_1 + a_offset;
            pair_weight=n;

            temp[j][n] += mmvq_dot_product(a_block_idx, b_qs_idx);
        }
    }
}

#if defined(DATA_A_Q4_K) || defined(DATA_A_Q5_K)
// Fast path for Q4_K/Q5_K: everything that is invariant across iterations (which sub-block of the
// superblock this thread works on, the scale bit positions, the B block's slot inside its q8_1_x4
// group) is computed once, and block indices are stepped instead of being re-derived with a multiply
// and a divide per column and iteration. This relies on ncols and stride_b being multiples of 256.
void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    const uint tid = gl_LocalInvocationID.x;

    get_offsets(a_offset, b_offset, d_offset);
    const uint a_offset_sb = a_offset;       // in superblocks
    b_offset /= QUANT_K_Q8_1;

    FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            temp[j][n] = FLOAT_TYPE(0.0f);
        }
    }

    const uint col_stride = K_PER_ITER * BLOCK_SIZE;
    uint num_iters = p.ncols / col_stride;
    if (num_iters * col_stride + K_PER_ITER * tid < p.ncols) {
        num_iters++;
    }

    // K_PER_ITER == 16: two threads share each 32 wide block, one takes the first half of its quants
    const uint b_qs_idx = tid % 2;
    const uint blk     = tid >> 1;           // 32-element block index inside the first column slice
    const uint is      = blk & 7;            // sub-block of the superblock, invariant over iterations
    const uint blk_k   = blk >> 3;           // superblock offset of that block

    // A side: quants and their shift, scale/min bit positions
    const uint iqs_k    = is * 8 + b_qs_idx * 4;
    const uint qs_idx   = (iqs_k / 16) * 8 + (iqs_k % 8);
    const uint qs_shift = ((iqs_k % 16) / 8) * 4;
#if defined(DATA_A_Q5_K)
    const uint qh_idx   = b_qs_idx * 4;
    const uint qh_shift = is;
#endif
    const uint scalesoffs = (is & 3) * 8;
    const uint scidx0     = (is < 4) ? 0 : 2;
    const uint scidxshift1 = (is < 4) ? scalesoffs : scalesoffs + 2;
    const uint mbidx0      = (is < 4) ? 1 : 2;
    const uint mbidxshift0 = (is < 4) ? scalesoffs : scalesoffs + 4;
    const uint mbidxshift1 = (is < 4) ? scalesoffs : scalesoffs + 2;

    const uint sb_stride = p.ncols / 256;
    uint ib_k[NUM_ROWS];
    [[unroll]] for (uint n = 0; n < num_rows; ++n) {
        ib_k[n] = (first_row + n) * sb_stride + a_offset_sb + blk_k;
    }

    // B side: slot inside the q8_1_x4 group never changes, the group index steps by a constant
    uint b_outer[NUM_COLS];
    uint b_inner[NUM_COLS];
    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        const uint b_idx = j * (p.batch_stride_b / QUANT_K_Q8_1) + b_offset + blk;
        b_outer[j] = b_idx / 4;
        b_inner[j] = b_idx % 4;
    }

    const uint blk_step_b = BLOCK_SIZE / 2 / 4;   // q8_1_x4 groups per iteration
    const uint blk_step_a = BLOCK_SIZE / 2 / 8;   // superblocks per iteration

    uint it = 0;
    for (; it + 3 < num_iters; it += 4) {
        {
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            const uint ib = ib_k[n];
            ib_k[n] += blk_step_a;

#if defined(DATA_A_Q4_K)
            const i32vec4 qs_a = i32vec4(
                (data_a_packed32[ib].qs[qs_idx    ] >> qs_shift) & 0x0F0F0F0F,
                (data_a_packed32[ib].qs[qs_idx + 1] >> qs_shift) & 0x0F0F0F0F,
                (data_a_packed32[ib].qs[qs_idx + 2] >> qs_shift) & 0x0F0F0F0F,
                (data_a_packed32[ib].qs[qs_idx + 3] >> qs_shift) & 0x0F0F0F0F);
#else
            const i32vec4 qs_a = i32vec4(
                ((data_a_packed32[ib].qs[qs_idx    ] >> qs_shift) & 0x0F0F0F0F) | (((data_a_packed32[ib].qh[qh_idx    ] >> qh_shift) & 0x01010101) << 4),
                ((data_a_packed32[ib].qs[qs_idx + 1] >> qs_shift) & 0x0F0F0F0F) | (((data_a_packed32[ib].qh[qh_idx + 1] >> qh_shift) & 0x01010101) << 4),
                ((data_a_packed32[ib].qs[qs_idx + 2] >> qs_shift) & 0x0F0F0F0F) | (((data_a_packed32[ib].qh[qh_idx + 2] >> qh_shift) & 0x01010101) << 4),
                ((data_a_packed32[ib].qs[qs_idx + 3] >> qs_shift) & 0x0F0F0F0F) | (((data_a_packed32[ib].qh[qh_idx + 3] >> qh_shift) & 0x01010101) << 4));
#endif

            const uint s0 = data_a_packed32[ib].scales[0];
            const uint sc_w = (scidx0 == 0) ? s0 : data_a_packed32[ib].scales[2];
            const uint mb_w = (mbidx0 == 1) ? data_a_packed32[ib].scales[1] : data_a_packed32[ib].scales[2];
            const uint sc    = ((sc_w >> scalesoffs) & 0xF) | ((s0 >> scidxshift1) & 0x30);
            const uint mbyte = ((mb_w >> mbidxshift0) & 0xF) | ((data_a_packed32[ib].scales[1] >> mbidxshift1) & 0x30);
            const vec2 dm_scale = vec2(data_a_packed32[ib].dm) * vec2(float(sc), float(mbyte));

            [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                const uint bo = b_outer[j];
                const uint bi = b_inner[j];
                const vec2 b_ds = vec2(data_b[bo].ds[bi]);
                int32_t q_sum = dotPacked4x8EXT(qs_a.x, data_b[bo].qs[bi * 8 + b_qs_idx * 4    ]);
                q_sum += dotPacked4x8EXT(qs_a.y, data_b[bo].qs[bi * 8 + b_qs_idx * 4 + 1]);
                q_sum += dotPacked4x8EXT(qs_a.z, data_b[bo].qs[bi * 8 + b_qs_idx * 4 + 2]);
                q_sum += dotPacked4x8EXT(qs_a.w, data_b[bo].qs[bi * 8 + b_qs_idx * 4 + 3]);

                temp[j][n] += FLOAT_TYPE(b_ds.x * dm_scale.x * float(q_sum) - dm_scale.y * (b_ds.y / 2));
            }
        }
        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            b_outer[j] += blk_step_b;
        }
        }
        {
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            const uint ib = ib_k[n];
            ib_k[n] += blk_step_a;

#if defined(DATA_A_Q4_K)
            const i32vec4 qs_a = i32vec4(
                (data_a_packed32[ib].qs[qs_idx    ] >> qs_shift) & 0x0F0F0F0F,
                (data_a_packed32[ib].qs[qs_idx + 1] >> qs_shift) & 0x0F0F0F0F,
                (data_a_packed32[ib].qs[qs_idx + 2] >> qs_shift) & 0x0F0F0F0F,
                (data_a_packed32[ib].qs[qs_idx + 3] >> qs_shift) & 0x0F0F0F0F);
#else
            const i32vec4 qs_a = i32vec4(
                ((data_a_packed32[ib].qs[qs_idx    ] >> qs_shift) & 0x0F0F0F0F) | (((data_a_packed32[ib].qh[qh_idx    ] >> qh_shift) & 0x01010101) << 4),
                ((data_a_packed32[ib].qs[qs_idx + 1] >> qs_shift) & 0x0F0F0F0F) | (((data_a_packed32[ib].qh[qh_idx + 1] >> qh_shift) & 0x01010101) << 4),
                ((data_a_packed32[ib].qs[qs_idx + 2] >> qs_shift) & 0x0F0F0F0F) | (((data_a_packed32[ib].qh[qh_idx + 2] >> qh_shift) & 0x01010101) << 4),
                ((data_a_packed32[ib].qs[qs_idx + 3] >> qs_shift) & 0x0F0F0F0F) | (((data_a_packed32[ib].qh[qh_idx + 3] >> qh_shift) & 0x01010101) << 4));
#endif

            const uint s0 = data_a_packed32[ib].scales[0];
            const uint sc_w = (scidx0 == 0) ? s0 : data_a_packed32[ib].scales[2];
            const uint mb_w = (mbidx0 == 1) ? data_a_packed32[ib].scales[1] : data_a_packed32[ib].scales[2];
            const uint sc    = ((sc_w >> scalesoffs) & 0xF) | ((s0 >> scidxshift1) & 0x30);
            const uint mbyte = ((mb_w >> mbidxshift0) & 0xF) | ((data_a_packed32[ib].scales[1] >> mbidxshift1) & 0x30);
            const vec2 dm_scale = vec2(data_a_packed32[ib].dm) * vec2(float(sc), float(mbyte));

            [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                const uint bo = b_outer[j];
                const uint bi = b_inner[j];
                const vec2 b_ds = vec2(data_b[bo].ds[bi]);
                int32_t q_sum = dotPacked4x8EXT(qs_a.x, data_b[bo].qs[bi * 8 + b_qs_idx * 4    ]);
                q_sum += dotPacked4x8EXT(qs_a.y, data_b[bo].qs[bi * 8 + b_qs_idx * 4 + 1]);
                q_sum += dotPacked4x8EXT(qs_a.z, data_b[bo].qs[bi * 8 + b_qs_idx * 4 + 2]);
                q_sum += dotPacked4x8EXT(qs_a.w, data_b[bo].qs[bi * 8 + b_qs_idx * 4 + 3]);

                temp[j][n] += FLOAT_TYPE(b_ds.x * dm_scale.x * float(q_sum) - dm_scale.y * (b_ds.y / 2));
            }
        }
        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            b_outer[j] += blk_step_b;
        }
        }
        {
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            const uint ib = ib_k[n];
            ib_k[n] += blk_step_a;

#if defined(DATA_A_Q4_K)
            const i32vec4 qs_a = i32vec4(
                (data_a_packed32[ib].qs[qs_idx    ] >> qs_shift) & 0x0F0F0F0F,
                (data_a_packed32[ib].qs[qs_idx + 1] >> qs_shift) & 0x0F0F0F0F,
                (data_a_packed32[ib].qs[qs_idx + 2] >> qs_shift) & 0x0F0F0F0F,
                (data_a_packed32[ib].qs[qs_idx + 3] >> qs_shift) & 0x0F0F0F0F);
#else
            const i32vec4 qs_a = i32vec4(
                ((data_a_packed32[ib].qs[qs_idx    ] >> qs_shift) & 0x0F0F0F0F) | (((data_a_packed32[ib].qh[qh_idx    ] >> qh_shift) & 0x01010101) << 4),
                ((data_a_packed32[ib].qs[qs_idx + 1] >> qs_shift) & 0x0F0F0F0F) | (((data_a_packed32[ib].qh[qh_idx + 1] >> qh_shift) & 0x01010101) << 4),
                ((data_a_packed32[ib].qs[qs_idx + 2] >> qs_shift) & 0x0F0F0F0F) | (((data_a_packed32[ib].qh[qh_idx + 2] >> qh_shift) & 0x01010101) << 4),
                ((data_a_packed32[ib].qs[qs_idx + 3] >> qs_shift) & 0x0F0F0F0F) | (((data_a_packed32[ib].qh[qh_idx + 3] >> qh_shift) & 0x01010101) << 4));
#endif

            const uint s0 = data_a_packed32[ib].scales[0];
            const uint sc_w = (scidx0 == 0) ? s0 : data_a_packed32[ib].scales[2];
            const uint mb_w = (mbidx0 == 1) ? data_a_packed32[ib].scales[1] : data_a_packed32[ib].scales[2];
            const uint sc    = ((sc_w >> scalesoffs) & 0xF) | ((s0 >> scidxshift1) & 0x30);
            const uint mbyte = ((mb_w >> mbidxshift0) & 0xF) | ((data_a_packed32[ib].scales[1] >> mbidxshift1) & 0x30);
            const vec2 dm_scale = vec2(data_a_packed32[ib].dm) * vec2(float(sc), float(mbyte));

            [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                const uint bo = b_outer[j];
                const uint bi = b_inner[j];
                const vec2 b_ds = vec2(data_b[bo].ds[bi]);
                int32_t q_sum = dotPacked4x8EXT(qs_a.x, data_b[bo].qs[bi * 8 + b_qs_idx * 4    ]);
                q_sum += dotPacked4x8EXT(qs_a.y, data_b[bo].qs[bi * 8 + b_qs_idx * 4 + 1]);
                q_sum += dotPacked4x8EXT(qs_a.z, data_b[bo].qs[bi * 8 + b_qs_idx * 4 + 2]);
                q_sum += dotPacked4x8EXT(qs_a.w, data_b[bo].qs[bi * 8 + b_qs_idx * 4 + 3]);

                temp[j][n] += FLOAT_TYPE(b_ds.x * dm_scale.x * float(q_sum) - dm_scale.y * (b_ds.y / 2));
            }
        }
        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            b_outer[j] += blk_step_b;
        }
        }
        {
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            const uint ib = ib_k[n];
            ib_k[n] += blk_step_a;

#if defined(DATA_A_Q4_K)
            const i32vec4 qs_a = i32vec4(
                (data_a_packed32[ib].qs[qs_idx    ] >> qs_shift) & 0x0F0F0F0F,
                (data_a_packed32[ib].qs[qs_idx + 1] >> qs_shift) & 0x0F0F0F0F,
                (data_a_packed32[ib].qs[qs_idx + 2] >> qs_shift) & 0x0F0F0F0F,
                (data_a_packed32[ib].qs[qs_idx + 3] >> qs_shift) & 0x0F0F0F0F);
#else
            const i32vec4 qs_a = i32vec4(
                ((data_a_packed32[ib].qs[qs_idx    ] >> qs_shift) & 0x0F0F0F0F) | (((data_a_packed32[ib].qh[qh_idx    ] >> qh_shift) & 0x01010101) << 4),
                ((data_a_packed32[ib].qs[qs_idx + 1] >> qs_shift) & 0x0F0F0F0F) | (((data_a_packed32[ib].qh[qh_idx + 1] >> qh_shift) & 0x01010101) << 4),
                ((data_a_packed32[ib].qs[qs_idx + 2] >> qs_shift) & 0x0F0F0F0F) | (((data_a_packed32[ib].qh[qh_idx + 2] >> qh_shift) & 0x01010101) << 4),
                ((data_a_packed32[ib].qs[qs_idx + 3] >> qs_shift) & 0x0F0F0F0F) | (((data_a_packed32[ib].qh[qh_idx + 3] >> qh_shift) & 0x01010101) << 4));
#endif

            const uint s0 = data_a_packed32[ib].scales[0];
            const uint sc_w = (scidx0 == 0) ? s0 : data_a_packed32[ib].scales[2];
            const uint mb_w = (mbidx0 == 1) ? data_a_packed32[ib].scales[1] : data_a_packed32[ib].scales[2];
            const uint sc    = ((sc_w >> scalesoffs) & 0xF) | ((s0 >> scidxshift1) & 0x30);
            const uint mbyte = ((mb_w >> mbidxshift0) & 0xF) | ((data_a_packed32[ib].scales[1] >> mbidxshift1) & 0x30);
            const vec2 dm_scale = vec2(data_a_packed32[ib].dm) * vec2(float(sc), float(mbyte));

            [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                const uint bo = b_outer[j];
                const uint bi = b_inner[j];
                const vec2 b_ds = vec2(data_b[bo].ds[bi]);
                int32_t q_sum = dotPacked4x8EXT(qs_a.x, data_b[bo].qs[bi * 8 + b_qs_idx * 4    ]);
                q_sum += dotPacked4x8EXT(qs_a.y, data_b[bo].qs[bi * 8 + b_qs_idx * 4 + 1]);
                q_sum += dotPacked4x8EXT(qs_a.z, data_b[bo].qs[bi * 8 + b_qs_idx * 4 + 2]);
                q_sum += dotPacked4x8EXT(qs_a.w, data_b[bo].qs[bi * 8 + b_qs_idx * 4 + 3]);

                temp[j][n] += FLOAT_TYPE(b_ds.x * dm_scale.x * float(q_sum) - dm_scale.y * (b_ds.y / 2));
            }
        }
        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            b_outer[j] += blk_step_b;
        }
        }
    }
    for (; it + 1 < num_iters; it += 2) {
        {
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            const uint ib = ib_k[n];
            ib_k[n] += blk_step_a;

#if defined(DATA_A_Q4_K)
            const i32vec4 qs_a = i32vec4(
                (data_a_packed32[ib].qs[qs_idx    ] >> qs_shift) & 0x0F0F0F0F,
                (data_a_packed32[ib].qs[qs_idx + 1] >> qs_shift) & 0x0F0F0F0F,
                (data_a_packed32[ib].qs[qs_idx + 2] >> qs_shift) & 0x0F0F0F0F,
                (data_a_packed32[ib].qs[qs_idx + 3] >> qs_shift) & 0x0F0F0F0F);
#else
            const i32vec4 qs_a = i32vec4(
                ((data_a_packed32[ib].qs[qs_idx    ] >> qs_shift) & 0x0F0F0F0F) | (((data_a_packed32[ib].qh[qh_idx    ] >> qh_shift) & 0x01010101) << 4),
                ((data_a_packed32[ib].qs[qs_idx + 1] >> qs_shift) & 0x0F0F0F0F) | (((data_a_packed32[ib].qh[qh_idx + 1] >> qh_shift) & 0x01010101) << 4),
                ((data_a_packed32[ib].qs[qs_idx + 2] >> qs_shift) & 0x0F0F0F0F) | (((data_a_packed32[ib].qh[qh_idx + 2] >> qh_shift) & 0x01010101) << 4),
                ((data_a_packed32[ib].qs[qs_idx + 3] >> qs_shift) & 0x0F0F0F0F) | (((data_a_packed32[ib].qh[qh_idx + 3] >> qh_shift) & 0x01010101) << 4));
#endif

            const uint s0 = data_a_packed32[ib].scales[0];
            const uint sc_w = (scidx0 == 0) ? s0 : data_a_packed32[ib].scales[2];
            const uint mb_w = (mbidx0 == 1) ? data_a_packed32[ib].scales[1] : data_a_packed32[ib].scales[2];
            const uint sc    = ((sc_w >> scalesoffs) & 0xF) | ((s0 >> scidxshift1) & 0x30);
            const uint mbyte = ((mb_w >> mbidxshift0) & 0xF) | ((data_a_packed32[ib].scales[1] >> mbidxshift1) & 0x30);
            const vec2 dm_scale = vec2(data_a_packed32[ib].dm) * vec2(float(sc), float(mbyte));

            [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                const uint bo = b_outer[j];
                const uint bi = b_inner[j];
                const vec2 b_ds = vec2(data_b[bo].ds[bi]);
                int32_t q_sum = dotPacked4x8EXT(qs_a.x, data_b[bo].qs[bi * 8 + b_qs_idx * 4    ]);
                q_sum += dotPacked4x8EXT(qs_a.y, data_b[bo].qs[bi * 8 + b_qs_idx * 4 + 1]);
                q_sum += dotPacked4x8EXT(qs_a.z, data_b[bo].qs[bi * 8 + b_qs_idx * 4 + 2]);
                q_sum += dotPacked4x8EXT(qs_a.w, data_b[bo].qs[bi * 8 + b_qs_idx * 4 + 3]);

                temp[j][n] += FLOAT_TYPE(b_ds.x * dm_scale.x * float(q_sum) - dm_scale.y * (b_ds.y / 2));
            }
        }
        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            b_outer[j] += blk_step_b;
        }
        }
        {
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            const uint ib = ib_k[n];
            ib_k[n] += blk_step_a;

#if defined(DATA_A_Q4_K)
            const i32vec4 qs_a = i32vec4(
                (data_a_packed32[ib].qs[qs_idx    ] >> qs_shift) & 0x0F0F0F0F,
                (data_a_packed32[ib].qs[qs_idx + 1] >> qs_shift) & 0x0F0F0F0F,
                (data_a_packed32[ib].qs[qs_idx + 2] >> qs_shift) & 0x0F0F0F0F,
                (data_a_packed32[ib].qs[qs_idx + 3] >> qs_shift) & 0x0F0F0F0F);
#else
            const i32vec4 qs_a = i32vec4(
                ((data_a_packed32[ib].qs[qs_idx    ] >> qs_shift) & 0x0F0F0F0F) | (((data_a_packed32[ib].qh[qh_idx    ] >> qh_shift) & 0x01010101) << 4),
                ((data_a_packed32[ib].qs[qs_idx + 1] >> qs_shift) & 0x0F0F0F0F) | (((data_a_packed32[ib].qh[qh_idx + 1] >> qh_shift) & 0x01010101) << 4),
                ((data_a_packed32[ib].qs[qs_idx + 2] >> qs_shift) & 0x0F0F0F0F) | (((data_a_packed32[ib].qh[qh_idx + 2] >> qh_shift) & 0x01010101) << 4),
                ((data_a_packed32[ib].qs[qs_idx + 3] >> qs_shift) & 0x0F0F0F0F) | (((data_a_packed32[ib].qh[qh_idx + 3] >> qh_shift) & 0x01010101) << 4));
#endif

            const uint s0 = data_a_packed32[ib].scales[0];
            const uint sc_w = (scidx0 == 0) ? s0 : data_a_packed32[ib].scales[2];
            const uint mb_w = (mbidx0 == 1) ? data_a_packed32[ib].scales[1] : data_a_packed32[ib].scales[2];
            const uint sc    = ((sc_w >> scalesoffs) & 0xF) | ((s0 >> scidxshift1) & 0x30);
            const uint mbyte = ((mb_w >> mbidxshift0) & 0xF) | ((data_a_packed32[ib].scales[1] >> mbidxshift1) & 0x30);
            const vec2 dm_scale = vec2(data_a_packed32[ib].dm) * vec2(float(sc), float(mbyte));

            [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                const uint bo = b_outer[j];
                const uint bi = b_inner[j];
                const vec2 b_ds = vec2(data_b[bo].ds[bi]);
                int32_t q_sum = dotPacked4x8EXT(qs_a.x, data_b[bo].qs[bi * 8 + b_qs_idx * 4    ]);
                q_sum += dotPacked4x8EXT(qs_a.y, data_b[bo].qs[bi * 8 + b_qs_idx * 4 + 1]);
                q_sum += dotPacked4x8EXT(qs_a.z, data_b[bo].qs[bi * 8 + b_qs_idx * 4 + 2]);
                q_sum += dotPacked4x8EXT(qs_a.w, data_b[bo].qs[bi * 8 + b_qs_idx * 4 + 3]);

                temp[j][n] += FLOAT_TYPE(b_ds.x * dm_scale.x * float(q_sum) - dm_scale.y * (b_ds.y / 2));
            }
        }
        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            b_outer[j] += blk_step_b;
        }
        }
    }
    if (it < num_iters) {
        {
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            const uint ib = ib_k[n];
            ib_k[n] += blk_step_a;

#if defined(DATA_A_Q4_K)
            const i32vec4 qs_a = i32vec4(
                (data_a_packed32[ib].qs[qs_idx    ] >> qs_shift) & 0x0F0F0F0F,
                (data_a_packed32[ib].qs[qs_idx + 1] >> qs_shift) & 0x0F0F0F0F,
                (data_a_packed32[ib].qs[qs_idx + 2] >> qs_shift) & 0x0F0F0F0F,
                (data_a_packed32[ib].qs[qs_idx + 3] >> qs_shift) & 0x0F0F0F0F);
#else
            const i32vec4 qs_a = i32vec4(
                ((data_a_packed32[ib].qs[qs_idx    ] >> qs_shift) & 0x0F0F0F0F) | (((data_a_packed32[ib].qh[qh_idx    ] >> qh_shift) & 0x01010101) << 4),
                ((data_a_packed32[ib].qs[qs_idx + 1] >> qs_shift) & 0x0F0F0F0F) | (((data_a_packed32[ib].qh[qh_idx + 1] >> qh_shift) & 0x01010101) << 4),
                ((data_a_packed32[ib].qs[qs_idx + 2] >> qs_shift) & 0x0F0F0F0F) | (((data_a_packed32[ib].qh[qh_idx + 2] >> qh_shift) & 0x01010101) << 4),
                ((data_a_packed32[ib].qs[qs_idx + 3] >> qs_shift) & 0x0F0F0F0F) | (((data_a_packed32[ib].qh[qh_idx + 3] >> qh_shift) & 0x01010101) << 4));
#endif

            const uint s0 = data_a_packed32[ib].scales[0];
            const uint sc_w = (scidx0 == 0) ? s0 : data_a_packed32[ib].scales[2];
            const uint mb_w = (mbidx0 == 1) ? data_a_packed32[ib].scales[1] : data_a_packed32[ib].scales[2];
            const uint sc    = ((sc_w >> scalesoffs) & 0xF) | ((s0 >> scidxshift1) & 0x30);
            const uint mbyte = ((mb_w >> mbidxshift0) & 0xF) | ((data_a_packed32[ib].scales[1] >> mbidxshift1) & 0x30);
            const vec2 dm_scale = vec2(data_a_packed32[ib].dm) * vec2(float(sc), float(mbyte));

            [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                const uint bo = b_outer[j];
                const uint bi = b_inner[j];
                const vec2 b_ds = vec2(data_b[bo].ds[bi]);
                int32_t q_sum = dotPacked4x8EXT(qs_a.x, data_b[bo].qs[bi * 8 + b_qs_idx * 4    ]);
                q_sum += dotPacked4x8EXT(qs_a.y, data_b[bo].qs[bi * 8 + b_qs_idx * 4 + 1]);
                q_sum += dotPacked4x8EXT(qs_a.z, data_b[bo].qs[bi * 8 + b_qs_idx * 4 + 2]);
                q_sum += dotPacked4x8EXT(qs_a.w, data_b[bo].qs[bi * 8 + b_qs_idx * 4 + 3]);

                temp[j][n] += FLOAT_TYPE(b_ds.x * dm_scale.x * float(q_sum) - dm_scale.y * (b_ds.y / 2));
            }
        }
        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            b_outer[j] += blk_step_b;
        }
        }
    }

    reduce_result(temp, d_offset, first_row, num_rows, tid);
}
#else
void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    const uint tid = gl_LocalInvocationID.x;

    get_offsets(a_offset, b_offset, d_offset);
    a_offset *= QUANT_K / QUANT_K_Q8_1;
    b_offset /= QUANT_K_Q8_1;

    FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            temp[j][n] = FLOAT_TYPE(0.0f);
        }
    }

    const uint col_stride = K_PER_ITER * BLOCK_SIZE;
    uint num_iters = p.ncols / col_stride;
    if (num_iters * col_stride + K_PER_ITER * tid < p.ncols) {
        num_iters++;
    }

    const uint b_qs_idx = tid % (32 / K_PER_ITER);
    uint col = tid * K_PER_ITER;
    while (num_iters >= 4) {
        // Manually partially unroll the loop
        [[unroll]] for (uint k = 0; k < 4; ++k) {
            iter(temp, first_row, num_rows, col, b_qs_idx);
            col += col_stride;
        }

        num_iters -= 4;
    }

    if (num_iters >= 2) {
        // Manually partially unroll the loop
        iter(temp, first_row, num_rows, col, b_qs_idx);
        col += col_stride;
        iter(temp, first_row, num_rows, col, b_qs_idx);
        col += col_stride;
        num_iters -= 2;
    }

    if (num_iters > 0) {
        iter(temp, first_row, num_rows, col, b_qs_idx);
    }

    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

#endif

void main(){
    const uint first_row=2*(gl_WorkGroupID.x+gl_NumWorkGroups.x*gl_WorkGroupID.z);
    if(first_row>=p.stride_d)return;
    compute_outputs(first_row,2);
}
