+// Private experiment: per-device pipeline state; no shared-header ABI changes.
+struct hier_argmax_state { vk_pipeline partial, final; std::vector<uint32_t> partial_code, final_code; };
+static std::mutex hier_argmax_mutex;
+static std::map<const void*, hier_argmax_state> hier_argmax_states;
+static hier_argmax_state& hier_argmax_get(vk_device& device) {
+    std::lock_guard<std::mutex> lock(hier_argmax_mutex);
+    auto it=hier_argmax_states.find(device.get());
+    if(it!=hier_argmax_states.end()) return it->second;
+    auto& state=hier_argmax_states[device.get()];
+    const char *dir=getenv("GGML_VK_HIER_ARGMAX_DIR");
+    if(!dir || device->vendor_id!=VK_VENDOR_ID_AMD || device->properties.deviceID!=0x7551 || device->subgroup_size!=64) return state;
+    auto load=[](const std::string& path) {
+        std::vector<uint32_t> code; std::ifstream f(path,std::ios::binary|std::ios::ate);
+        if(f) { auto n=f.tellg(); if(n>=20 && uint64_t(n)%4==0) {code.resize(size_t(n)/4); f.seekg(0); f.read((char*)code.data(),n); if(!f || code[0]!=0x07230203u)code.clear();} }
+        return code;
+    };
+    state.partial_code=load(std::string(dir)+"/partial.spv"); state.final_code=load(std::string(dir)+"/final.spv");
+    GGML_ASSERT(!state.partial_code.empty() && !state.final_code.empty());
+    fprintf(stderr,"HIER_ARGMAX_MODULES partial=%zu final=%zu\n",state.partial_code.size(),state.final_code.size());
+    return state;
+}
